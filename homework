.data
entera: .asciiz "Enter number a: "
enterb: .asciiz "Enter number b: "
result: .asciiz "Difference = "
.text 
.globl main
main:
li $v0, 4
la $a0, entera
syscall
li $v0, 5
syscall
move $t0, $v0

li $v0, 4
la $a0, enterb
syscall
li $v0, 5
syscall
move $t1, $v0

bgt $t0, $t1, greater
blt  $t0, $t1, less

greater:
sub $t2, $t0, $t1
j end
less:
sub $t2, $t1, $t0
j end

end:
li $v0, 4
la $a0, result
syscall
li $v0, 1
move $a0, $t2
syscall
li $v0, 10
syscall

